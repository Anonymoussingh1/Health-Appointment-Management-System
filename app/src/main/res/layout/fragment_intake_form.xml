<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digital Intake Form"
            android:textColor="#0D47A1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Please complete your pre-visit health questionnaire."
            android:textColor="#546E7A"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Chief Complaint / Symptoms"
            android:textColor="#37474F"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="e.g. Fever, cough, headache for 3 days"
            android:padding="12dp"
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Known Allergies"
            android:textColor="#37474F"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAllergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="e.g. Penicillin, Peanuts (or None)"
            android:padding="12dp"
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Current Medications"
            android:textColor="#37474F"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editMeds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="e.g. Paracetamol 500mg"
            android:padding="12dp"
            android:textColor="#000000"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSubmitIntake"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="Submit Intake Form" />

    </LinearLayout>
</ScrollView>
