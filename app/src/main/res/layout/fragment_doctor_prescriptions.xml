<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-Prescriptions &amp; Lab Orders"
            android:textColor="#0D47A1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select a registered patient and issue prescriptions or review refill requests."
            android:textColor="#546E7A"
            android:textSize="14sp" />

        <!-- Incoming Refill Requests Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Incoming Patient Refill Requests"
            android:textColor="#C62828"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRefillRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/textNoRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No pending refill requests from patients"
            android:textColor="#78909C"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Patient"
            android:textColor="#37474F"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerPatients"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/btn_dropdown"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Prescription / Lab Details"
            android:textColor="#37474F"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editRx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Medication name, dosage &amp; instructions"
            android:padding="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnIssueRx"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="Issue E-Prescription to Patient" />

        <Button
            android:id="@+id/btnOrderLabs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Order Lab Tests / Specialist Referral" />

    </LinearLayout>
</ScrollView>
